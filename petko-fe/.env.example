# ============================================================
# Petko Frontend — Environment Configuration
# Copy this file to .env.local and fill in your Supabase credentials:
#   cp .env.example .env.local
#
# ⚠️ Every VITE_* value is PUBLIC: it is embedded in the browser bundle.
# Never put the Supabase service_role key or any other secret here.
# ============================================================

# Supabase project URL (e.g., https://xyzcompany.supabase.co)
# Found in: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anon (public) Key
# Found in: Supabase Dashboard → Project Settings → API → anon / public
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# OPTIONAL — NestJS API base URL. Defaults to same-origin "/api":
# in dev the Vite server proxies /api to http://localhost:3000, and on
# Vercel the API function is served from the same domain. Only set this to
# target an API on another origin (include the /api suffix).
# VITE_API_URL=https://api.example.com/api
