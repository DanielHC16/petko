# ============================================================
# Root .gitignore — Petko Monorepo
# ============================================================

# Dependencies
node_modules/
*/node_modules/
.pnp
.pnp.js

# Environment & Secret Files (Keep .env.example tracked)
.env
.env.*
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local
!*.env.example
!.env.example
!*/.env.example

# OAuth Secrets / Credentials / Keys / Certs
client_secret*.json
*secret*.json
*credential*.json
*.pem
*.key
*.cert
*.crt

# Production & Build Outputs
dist/
*/dist/
dist-ssr/
*/dist-ssr/
build/
*/build/
out/
*/out/
*.tsbuildinfo
.tmp/
*/.tmp/
.temp/
*/.temp/
supabase/.temp/
*/supabase/.temp/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Coverage / Testing
coverage/
*/coverage/
.nyc_output/

# IDE / OS Files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# Vercel CLI link/build output & local agent workspace
.vercel/
.agents/
/api/**/*.map
