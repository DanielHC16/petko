# ============================================================
# Petko Backend — Environment Configuration
# Copy this file to .env and fill in your Supabase credentials:
#   cp .env.example .env
# ============================================================

NODE_ENV=development
PORT=3000

# Supabase project URL (e.g., https://xyzcompany.supabase.co)
# Found in: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Service Role Secret Key (REQUIRED for server-side admin operations)
# Found in: Supabase Dashboard → Project Settings → API → service_role secret
# ⚠️ Keep this secret and NEVER expose it to the frontend or commit it to Git!
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Supabase Anon (public) Key (Used for JWT verification)
# Found in: Supabase Dashboard → Project Settings → API → anon / public
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Frontend URL (Used for CORS configuration)
FRONTEND_URL=http://localhost:5173
