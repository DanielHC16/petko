.env
.env.*
*.env
*.local
!*.env.example
!.env.example
client_secret*.json
*secret*.json
*credential*.json
*.pem
*.key
*.cert
*.crt

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing & Coverage
coverage/
.nyc_output/

# IDEs & System
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/